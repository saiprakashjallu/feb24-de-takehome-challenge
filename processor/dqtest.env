# Isolated data-quality load-test environment (same LocalStack, separate
# stream, bucket, checkpoint and MLflow store). Load it from processor/ with:
#     set -a; source dqtest.env; set +a
# Unset it (or open a new shell) to go back to the main MyStream / my-bucket.

KINESIS_STREAM_NAME=DQTestStream
S3_BUCKET_NAME=dq-test-bucket
BRONZE_PATH=s3://dq-test-bucket/bronze/articles/
ML_READY_PATH=s3://dq-test-bucket/ml-ready/
ML_TRAINING_PATH=s3://dq-test-bucket/ml/training/articles/
MONITORING_PATH=s3://dq-test-bucket/monitoring/
MALFORMED_PATH=s3://dq-test-bucket/quarantine/malformed/
CHECKPOINT_PATH=s3://dq-test-bucket/checkpoints/kinesis/
MLFLOW_TRACKING_URI=file:./mlruns-dqtest
